# OpenAI — used for embeddings (text-embedding-3-small) and LLM calls (gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone — used for vector storage and retrieval
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone index name — default index built by ingest.py (text-embedding-3-small, 1536 dims)
PINECONE_INDEX_NAME=exorde-social-media

# Pinecone index name for the BGE embedding experiment — built by ingest_bge.py (1024 dims)
PINECONE_BGE_INDEX_NAME=exorde-embed-bge

# Pinecone index name for the theme-grouped chunking experiment — built by ingest_theme_grouped.py (1536 dims)
PINECONE_THEME_INDEX_NAME=exorde-chunked-theme

# Pinecone index name for the hybrid search experiment — built by ingest_hybrid.py (1536 dims, dotproduct metric)
PINECONE_HYBRID_INDEX_NAME=exorde-hybrid
